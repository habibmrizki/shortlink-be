# Server Configuration
PORT=2901
# Leave empty to use the request host, or set the public URL (for example https://short.example.com).
BASE_URL=

# PostgreSQL Database Configuration
DBUSER=postgres
DBPASS=postgres
DBHOST=localhost
DBPORT=5432
DBNAME=shortlink

# PostgreSQL container initialization (keep these aligned with DBUSER/DBPASS/DBNAME)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shortlink

# Redis Cache Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key
JWT_ISSUER=shortlink

